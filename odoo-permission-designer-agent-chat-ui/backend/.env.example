# OpenAI-compatible gateway (DeepSeek official or company proxy)
OPENAI_API_KEY=replace_me
# Prefer full base URL ending with /v1 for ChatOpenAI
OPENAI_API_BASE=https://api.deepseek.com/v1

# LangChain: openai:<api-model-name>
# Company gateway may only allow: deepseek-v4-pro | deepseek-v4-flash
# Official DeepSeek often uses: deepseek-chat | deepseek-reasoner
MODEL=openai:deepseek-v4-pro

LANGSMITH_TRACING=false
